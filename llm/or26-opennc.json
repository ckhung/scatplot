{
  "source": {
    "csv": "llm/or26-opennc.csv",
    "textcols": ["provider", "id","modality"],
    "pkey": "id"
  },
  "plotly": {
    "layout": {
      "title": "OpenRouter 開放權重非紅模型比較",
      "shapes": [
	{
	  "type": "shape",
	  "path": "M 28 23 L 28 25 L 26 25 Z",
          "line": {
            "color": "#c00000",
            "width": 2
          }
	}
      ]
    },
    "maintrace": {
      "xaxis": { "expr": "intelligence" },
      "yaxis": { "expr": "agentic" },
      "size": { "expr": "8/(output+input*0.2)" },
      "maintext": "id",
      "hovertext": "${id}<br />${provider}<br />code: ${coding}",
      "color": {
        "default": "#444",
        "colname": "provider",
	"palette": {
	    "google": "#00f",
	    "openai": "#088",
	    "nvidia": "#0f0",
	    "mistralai": "#808",
	    "thinkingmachines": "#880"
	}
      }
    }
  }
}
