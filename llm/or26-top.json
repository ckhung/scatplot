{
  "source": {
    "csv": "llm/or26-top.csv",
    "textcols": ["provider", "id","modality"],
    "pkey": "id"
  },
  "plotly": {
    "layout": {
      "title": "OpenRouter 頂尖模型比較",
      "shapes": [
	{
	  "type": "shape",
	  "path": "M 55 55 L 55 60 L 50 60 Z",
          "line": {
            "color": "#c00000",
            "width": 2
          }
	}
      ]
    },
    "maintrace": {
      "xaxis": { "expr": "intelligence" },
      "yaxis": { "expr": "agentic" },
      "size": { "expr": "40/(output+input*0.2)" },
      "maintext": "id",
      "hovertext": "${id}<br />${provider}<br />code: ${coding}",
      "color": {
        "default": "#444",
        "colname": "provider",
	"palette": {
	    "anthropic": "#0f0",
	    "openai": "#088",
	    "meta": "#f00",
	    "qwen": "#cc4",
	    "z-ai": "#4cc",
	    "deepseek": "#c44",
	    "x-ai": "#088",
	    "minimax": "#4c4",
	    "moonshotai": "#44c",
	    "google": "#00f",
	    "mistralai": "#808"
	}
      }
    }
  }
}
