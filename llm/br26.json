{
  "source": {
    "csv": "llm/di-c.csv",
    "textcols": ["Model","Provider"],
    "pkey": "Model"
  },
  "plotly": {
    "layout": {
      "title": "AWS Bedrock 模型比較",
      "shapes": [
	{
	  "type": "shape",
	  "path": "M 3 8 L 3 10 L 4.5 10 Z",
          "line": {
            "color": "#c00000",
            "width": 2
          }
	}
      ]
    },
    "maintrace": {
      "xaxis": { "expr": "log(Price)" },
      "yaxis": { "expr": "Quality" },
      "size": { "expr": 20 },
      "maintext": "Model",
      "hovertext": "${Model}<br />${Provider}",
      "color": {
        "default": "#0cc",
        "colname": "Provider"
      }
    }
  }
}
